/* ═══════════════════════════════════════════════════════════════
   OmniDebate v1.0.0 — Unified Design System
   © 2026 OmniSuite. Built for the Digital Grandmaster.
   ═══════════════════════════════════════════════════════════════ */

/* ── Design Tokens ── */
$primary: #10b981;
$accent: #6366f1;
$danger: #ef4444;
$warning: #f59e0b;
$success: #4ade80;
$background: #020617;
$surface: #0f172a;
$surface-elevated: #1e293b;
$border: #334155;
$text-primary: #f1f5f9;
$text-secondary: #94a3b8;
$text-muted: #475569;

/* ════════════════════════════════════════════
   SECTION 1: Global Screen
   ════════════════════════════════════════════ */
Screen {
    background: $background;
    color: $text-primary;
}

/* ── Active Speech Mode ── */
#zone-gamma.speech-mode {
    background: #000000;
    border: thick $primary;
}
#zone-gamma.speech-mode #card-detail {
    color: #ffffff;
}
#zone-gamma.speech-mode .zone-header {
    background: $primary;
    color: black;
    text-style: bold blink;
}

/* ── High Contrast Accessibility ── */
Screen.high-contrast {
    background: #000000;
    color: #ffffff;
}
Screen.high-contrast .tactical-zone {
    border: solid #ffffff;
    background: #000000;
}
Screen.high-contrast .zone-header {
    background: #00ff00;
    color: #000000;
}

/* ── Screen Reader Linear Layout ── */
#main-layout.screen-reader-optimized {
    layout: vertical;
    overflow-y: scroll;
}
#main-layout.screen-reader-optimized .tactical-zone {
    width: 100%;
    height: auto;
    min-height: 20;
    border-bottom: double $primary;
}

/* ════════════════════════════════════════════
   SECTION 2: Side Ribbon
   ════════════════════════════════════════════ */
#side-ribbon {
    width: 10;
    height: 1fr;
    background: $background;
    border-right: solid $border;
    align: center top;
    padding: 1 0;
}
.ribbon-btn {
    min-width: 8;
    width: 8;
    height: 4;
    margin: 1 0;
    background: transparent;
    border: none;
    padding: 0;
    color: $text-muted;
    text-align: center;
    content-align: center middle;
}
.ribbon-btn:hover {
    color: $primary;
    background: $primary 10%;
}

/* ════════════════════════════════════════════
   SECTION 3: Main Grid Layout
   ════════════════════════════════════════════ */
#main-layout {
    layout: grid;
    grid-size: 5;
    grid-columns: 1fr 1fr 1fr 2fr 1fr;
    grid-gutter: 0 1;
    height: 1fr;
}

/* ── Tactical Zones ── */
.tactical-zone {
    height: 1fr;
    padding: 0 1;
    overflow: hidden hidden;
    transition: background 200ms;
    background: $surface;
}

#motion-list {
    height: 1fr;
    overflow-y: auto;
}

#evidence-list {
    height: 1fr;
    overflow-y: auto;
}

#hud-container {
    height: 1fr;
    overflow-y: auto;
}


#zone-epsilon {
    background: $background;
    border-right: tall $border;
}
#zone-alpha {
    background: $surface;
    border-right: tall $border;
}
#zone-beta {
    background: $surface-elevated;
    border-right: tall $border;
}
#zone-gamma {
    background: $surface;
    border-right: tall #475569;
}
#zone-delta {
    background: $surface-elevated;
}

/* ── Zone Headers ── */
.zone-header {
    text-align: center;
    text-style: bold;
    background: $border;
    color: $text-secondary;
    width: 100%;
    margin-bottom: 1;
    height: 1;
}
#zone-epsilon .zone-header { background: #8b5cf6; color: black; border-bottom: solid #7c3aed; }
#zone-alpha .zone-header { background: $primary; color: black; border-bottom: solid #059669; }
#zone-beta .zone-header  { background: #3b82f6; color: white; border-bottom: solid #2563eb; }
#zone-gamma .zone-header { background: $warning; color: black; border-bottom: solid #d97706; }
#zone-delta .zone-header { background: $accent; color: white; border-bottom: solid #4f46e5; }

/* ════════════════════════════════════════════
   SECTION 4: Evidence List & Cards
   ════════════════════════════════════════════ */
#evidence-list ListItem {
    padding: 0 1;
    margin: 0 1 1 1;
    border: solid transparent;
    transition: border 200ms, background 200ms;
}
#evidence-list ListItem:hover {
    background: $primary 5%;
    border: solid $primary;
}
#evidence-list ListItem:focus {
    background: $primary 15%;
    color: $primary;
    border: solid $primary;
    text-style: bold;
}

.card-body {
    padding: 0 1;
    color: $text-secondary;
    border-left: solid $primary;
}

.side-aff { border-left: tall #10b981; background: #10b981 5%; }
.side-neg { border-left: tall #ef4444; background: #ef4444 5%; }

/* ── Motion List ── */
#motion-list ListItem {
    height: 1;
    padding: 0 1;
    transition: background 150ms;
}
#motion-list ListItem:hover {
    background: $primary 10%;
}
#motion-list ListItem:focus {
    background: $primary;
    color: black;
    text-style: bold;
}

/* ═══ Nexus Actions ═══ */
#nexus-actions {
    dock: bottom;
    height: 3;
    margin: 0 1;
    background: $surface;
    border-top: solid $border;
}
#nexus-actions Button {
    width: 100%;
    height: 1;
    margin: 0;
    padding: 0;
    text-style: bold;
    border: none;
}
#nexus-actions Button:hover {
    background: $primary 20%;
}

/* ═══ Action Deck ═══ */
.action-deck {
    dock: bottom;
    height: 2;
    margin: 0 1;
    background: $background;
    border-top: solid $border;
}
.action-deck Button {
    width: 100%;
    height: 1;
    margin: 0;
    padding: 0;
    text-style: bold;
    border: none;
}
.action-deck Button:hover {
    background: $primary 20%;
}


/* ════════════════════════════════════════════
   SECTION 5: Tier Colors & Labels
   ════════════════════════════════════════════ */
.section-label {
    padding: 0 2;
    color: $text-muted;
    text-style: bold;
    background: $surface;
    height: 1;
}

.tier-5 { color: $warning; text-style: bold italic underline; }
.tier-4 { color: $primary; text-style: bold; }
.tier-3 { color: #3b82f6; }
.tier-2 { color: $text-secondary; }
.tier-1 { color: $text-muted; text-style: dim; }

/* ════════════════════════════════════════════
   SECTION 6: Oracle HUD Groups
   ════════════════════════════════════════════ */
.hud-group {
    border: solid $border;
    background: $surface;
    margin: 1 0;
    padding: 0 1;
    height: auto;
}
.hud-group-label {
    text-style: bold;
    color: $primary;
    background: $primary 10%;
    width: 100%;
    padding: 0 1;
}

.bar-critical { color: $danger; text-style: bold; }
.bar-caution  { color: $warning; }
.bar-optimal  { color: $primary; text-style: bold; }

.hidden { display: none; }

/* ════════════════════════════════════════════
   SECTION 7: Breadcrumb & Filters
   ════════════════════════════════════════════ */
#breadcrumb-bar {
    background: $surface;
    color: $primary;
    padding: 0 1;
    border-bottom: solid $border;
    height: 1;
    text-style: bold;
}

.filter-chips {
    height: 3;
    margin-bottom: 1;
    background: transparent;
}

#card-detail {
    height: 1fr;
    overflow-y: auto;
    background: transparent;
    padding: 1 2;
}

#brief-actions-row {
    dock: bottom;
    height: 3;
    background: $surface;
    border-top: solid $border;
    align: center middle;
    padding: 0 1;
}
#brief-actions-row Button {
    width: 1fr;
    height: 3;
    margin: 0 1;
    padding: 0;
}

/* ════════════════════════════════════════════
   SECTION 8: Command HUD
   ════════════════════════════════════════════ */
CommandHUD {
    height: 1fr;
    background: transparent;
    padding: 0 1;
    overflow-y: auto;
}
.hud-section {
    margin-top: 1;
    margin-bottom: 1;
    padding: 1 1;
    border-bottom: solid $border;
    height: auto;
}
.hud-section Label {
    margin-bottom: 1;
}
.hud-section Select {
    width: 100%;
    height: auto;
}
.hud-big-time {
    text-style: bold;
    color: $accent;
    background: $background;
    border: tall $accent;
    padding: 0 1;
    text-align: center;
    width: 100%;
    height: 3;
    content-align: center middle;
    margin-top: 1;
    margin-bottom: 1;
}
.hud-label { color: $primary; text-style: bold; }
.hud-state-text { color: $text-primary; text-style: italic; }

#hud-progress {
    height: 1;
    margin-top: 1;
    text-align: center;
    color: $primary;
}
.progress-bar-fill { background: $primary; }

#hud-controls-section {
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-gutter: 1 1;
    margin-top: 1;
    height: auto;
}
#hud-controls-section Button {
    width: 100%;
    height: 3;
    margin: 0;
    padding: 0;
}
#btn-speech-toggle {
    column-span: 2;
}
#btn-prep-toggle {
    column-span: 2;
}
#btn-speech-prep-workspace {
    column-span: 2;
}
#btn-speech-toggle:hover, #btn-prep-toggle:hover {
    background: $accent 20%;
}
#btn-speech-toggle:focus, #btn-prep-toggle:focus {
    border: double $accent;
    text-style: bold;
}

#speech-timer-display.timer-running {
    text-style: bold blink;
    color: $warning;
}

.hud-expired { color: $danger; text-style: bold blink; border: tall $danger; }
.hud-running { color: $success; border: tall $success; }

/* ════════════════════════════════════════════
   SECTION 9: System Log Widget
   ════════════════════════════════════════════ */
SystemLog {
    height: 10;
    border: thick $primary;
    background: $background;
    padding: 0 1 1 1;
    margin-bottom: 1;
    color: #9ca3af;
}
.log-header {
    text-align: center;
    text-style: bold;
    background: $surface;
    color: $primary;
    width: 100%;
    border-left: thick $primary;
    border-bottom: solid $border;
    margin-bottom: 1;
}
.log-content {
    padding: 0 1;
    color: #9ca3af;
}

/* ════════════════════════════════════════════
   SECTION 10: Quick Notes Widget
   ════════════════════════════════════════════ */
QuickNotes {
    height: 1fr;
    min-height: 12;
    border: thick $primary;
    padding: 0 1 1 1;
    margin-bottom: 1;
    background: $background;
    transition: border 200ms;
}
QuickNotes.notes-saving {
    border: thick $primary;
}
QuickNotes Label {
    text-align: center;
    text-style: bold;
    background: $surface;
    color: $primary;
    width: 100%;
    border-left: thick $primary;
    border-bottom: solid $border;
    margin-bottom: 1;
}
QuickNotes TextArea {
    height: 1fr;
    background: transparent;
    border: none;
    color: $text-primary;
}

/* ════════════════════════════════════════════
   SECTION 11: Modal Screen Defaults
   ════════════════════════════════════════════ */

/* Shared modal overlay pattern */
.modal-overlay {
    align: center middle;
    background: $background 70%;
}
.modal-dialog {
    width: 85;
    height: auto;
    max-height: 46;
    background: $surface;
    border: thick $primary;
    padding: 1 2;
}
.modal-title {
    text-align: center;
    text-style: bold;
    background: $primary;
    color: black;
    margin-bottom: 1;
    width: 100%;
}
.modal-footer {
    align: center middle;
    height: 3;
    margin-top: 1;
}

/* ── Splash Screen ── */
SplashScreen {
    align: center middle;
    background: $background;
}
#splash-container {
    width: 90;
    height: auto;
    align: center middle;
    background: $surface;
    border: thick $primary;
    padding: 2 4;
}
#splash-logo {
    text-align: center;
    color: $primary;
    text-style: bold;
    margin-bottom: 1;
}
#splash-status {
    text-align: center;
    color: $text-primary;
    text-style: bold;
    margin-top: 1;
}
#splash-log-line {
    text-align: center;
    color: #4ade80; /* Emerald green hacker style */
    text-style: italic;
    height: 1;
    margin-top: 1;
}
#splash-bar {
    text-align: center;
    color: $accent;
    text-style: bold;
    margin-top: 1;
}
#splash-footer {
    text-align: center;
    color: $text-muted;
    text-style: italic;
    margin-top: 1;
}

/* ── Analytics Screen ── */
AnalyticsScreen {
    align: center middle;
    background: $background 70%;
}
#stats-dialog {
    width: 90%;
    height: 90%;
    max-width: 180;
    max-height: 50;
    background: $surface;
    border: thick $primary;
    padding: 1 2;
    overflow-y: auto;
}
.stats-title {
    text-align: center;
    text-style: bold;
    background: $primary;
    color: black;
    margin-bottom: 1;
    width: 100%;
}
.section-header {
    text-style: bold;
    color: $primary;
    margin-top: 1;
}
#heatmap-view {
    height: 12;
    background: $background;
    border: solid $primary;
    margin-bottom: 1;
    padding: 1 2;
}
#velocity-graph {
    height: 8;
    background: $background;
    border: solid $primary;
    margin-bottom: 1;
    padding: 1 2;
}
.dashboard-footer {
    align: center middle;
    height: 3;
}

/* ── Settings Screen ── */
SettingsScreen {
    align: center middle;
    background: $background 70%;
}
#settings-dialog {
    width: 85;
    height: auto;
    max-height: 42;
    background: $surface;
    border: thick $primary;
    padding: 1 2;
}
#settings-title {
    text-align: center;
    text-style: bold;
    background: $primary;
    color: black;
    margin-bottom: 1;
    width: 100%;
}
.settings-section {
    text-style: bold;
    color: $primary;
    margin-top: 1;
    border-bottom: solid $primary;
    padding-bottom: 1;
}
#settings-btns {
    align: center middle;
    height: 3;
    margin-top: 1;
}

/* ── Search Screen ── */
SearchScreen {
    align: center middle;
    background: $background 70%;
}
#search-dialog {
    width: 100;
    height: 38;
    background: $surface;
    border: thick $primary;
    padding: 1 2;
}
#search-title {
    text-align: center;
    text-style: bold;
    background: $primary;
    color: black;
    margin-bottom: 1;
    width: 100%;
}

/* ── Help Screen ── */
HelpScreen {
    align: center middle;
    background: $background 60%;
}
#help-dialog {
    width: 85;
    height: 38;
    background: $surface;
    border: thick $primary;
    padding: 1 2;
}
#help-title {
    text-align: center;
    text-style: bold;
    background: $primary;
    color: black;
    margin-bottom: 1;
    width: 100%;
}
HelpScreen DataTable {
    height: 1fr;
    background: $background;
    border: solid $primary;
    color: $text-primary;
    margin-bottom: 1;
}

/* ── Exit Screen ── */
ExitScreen {
    align: center middle;
    background: $background 60%;
}
#exit-dialog {
    width: 60;
    height: auto;
    background: $surface;
    border: thick $danger;
    padding: 1 2;
}
.exit-title {
    text-align: center;
    text-style: bold;
    background: $danger;
    color: white;
    margin-bottom: 1;
}
.exit-stat { margin: 1 0; }

/* ── Palette Screen ── */
CommandPaletteScreen {
    align: center middle;
    background: $background 70%;
}
#palette-dialog {
    width: 90;
    height: 32;
    background: $surface;
    border: thick $primary;
    padding: 1 2;
}
#palette-title {
    text-align: center;
    text-style: bold;
    background: $primary;
    color: black;
    margin-bottom: 1;
    width: 100%;
}

/* ── Card Add/Edit Screen ── */
AddCardScreen {
    align: center middle;
    background: $background 60%;
}
#add-card-dialog {
    width: 85;
    height: auto;
    max-height: 45;
    background: $surface;
    border: thick $primary;
    padding: 1 2;
}
#add-card-dialog Label { margin-top: 1; color: $primary; text-style: bold; }
#add-card-dialog Input { margin-bottom: 0; background: $background; border: none; border-bottom: solid $primary; }
#add-card-dialog TextArea { height: 8; margin-bottom: 1; background: $background; }
#btn-row { align: center middle; height: 3; margin-top: 1; }
#btn-row Button { margin: 0 1; }

/* ── Compare Screen ── */
CompareScreen {
    align: center middle;
    background: $background 70%;
}
#compare-container {
    width: 90%;
    height: 90%;
    max-width: 180;
    max-height: 50;
    background: $surface;
    border: thick $primary;
    padding: 1;
}
.compare-pane {
    width: 1fr;
    height: 1fr;
    border: solid $primary;
    margin: 0 1;
    background: $background;
    overflow-y: auto;
}
#compare-title {
    text-align: center;
    text-style: bold;
    background: $primary;
    color: black;
    margin-bottom: 1;
    width: 100%;
}

/* ── Impact Map Screen ── */
ImpactMapScreen {
    align: center middle;
    background: $background 60%;
}
#impact-dialog {
    width: 85;
    height: auto;
    background: $surface;
    border: thick $primary;
    padding: 1 2;
}
#impact-title {
    text-align: center;
    text-style: bold;
    background: $primary;
    color: black;
    margin-bottom: 1;
}
#impact-tree {
    padding: 1 2;
    border: solid $primary;
    background: $background;
    color: $text-primary;
    margin: 1 0;
    min-height: 10;
}

/* ── DOCX Import Screen ── */
DocxIngestScreen { align: center middle; }
#di-dialog {
    width: 60;
    height: auto;
    background: $surface;
    border: double $primary;
    padding: 1 2;
}

/* ── Web Ingest Screen ── */
WebIngestScreen { align: center middle; }
#wi-dialog {
    width: 74;
    height: auto;
    background: $surface;
    border: double $success;
    padding: 1 2;
}
#wi-preview { height: 8; border: solid $primary; padding: 1; overflow-y: auto; }
#ai-glow { color: $primary; text-style: bold italic; }

/* ── Motion Add Screen ── */
AddMotionScreen { align: center middle; }
#motion-dialog {
    width: 60;
    height: auto;
    background: $surface;
    border: double $accent;
    padding: 1 2;
}

/* ── Export Brief Screen ── */
ExportBriefScreen { align: center middle; }
#export-dialog {
    width: 74;
    height: auto;
    background: $surface;
    border: double $warning;
    padding: 1 2;
}
#export-settings-body {
    margin: 1 0;
    height: auto;
}

/* ── Drill Screen ── */
DrillScreen {
    align: center middle;
    background: $background 70%;
}
#drill-dialog {
    width: 90;
    height: auto;
    max-height: 40;
    background: $surface;
    border: thick $warning;
    padding: 1 2;
}
.drill-question {
    border: solid $warning;
    padding: 1 2;
    margin: 1 0;
    background: $background;
    color: $text-primary;
}
.drill-footer {
    align: center middle;
    height: 3;
    margin-top: 1;
}

/* ── Recovery Screen ── */
RecoveryScreen {
    align: center middle;
    background: $background 70%;
}
#recovery-dialog {
    width: 90;
    height: auto;
    max-height: 36;
    background: $surface;
    border: thick $accent;
    padding: 1 2;
}

/* ── Tutorial Screen ── */
TutorialScreen {
    align: center middle;
    background: $background;
}
#tutorial-dialog {
    width: 80;
    height: auto;
    max-height: 38;
    background: $surface;
    border: thick $primary;
    padding: 2 3;
}

/* ── Summary/Synthesis Screen ── */
SynthesisScreen {
    align: center middle;
    background: $background 70%;
}
#synth-dialog {
    width: 100;
    height: 38;
    background: $surface;
    border: thick $primary;
    padding: 1 2;
}

/* ── Speech Prep Screen ── */
SpeechPrepScreen {
    align: center middle;
    background: $background 80%;
}
#speech-dialog {
    width: 95%;
    height: 95%;
    background: $surface;
    border: thick $primary;
    padding: 1 2;
    layout: vertical;
}

#speech-header {
    height: 3;
    border-bottom: solid $border;
    align: center middle;
}
#speech-header-title {
    text-style: bold;
    color: $primary;
}

#speech-controls-row {
    height: auto;
    margin-top: 1;
    margin-bottom: 1;
    layout: horizontal;
    align: center middle;
}

#speech-timer-container {
    width: 32;
    height: 7;
    align: center middle;
    border: tall $border;
    background: $background;
    padding: 0 1;
}

#speech-timer-display {
    text-style: bold;
    color: $success;
}

#speech-name-display {
    color: $text-secondary;
}

#speech-mode-selector {
    width: 20;
    margin-left: 2;
    layout: vertical;
}
#speech-mode-selector Button {
    width: 100%;
    margin-bottom: 0;
    height: 1;
    border: none;
    padding: 0;
}

#speech-gauges-container {
    width: 48;
    margin-left: 2;
    layout: vertical;
    padding: 0 1;
}

#speech-actions-container {
    width: 38;
    margin-left: 2;
    layout: vertical;
    align: center middle;
}
#speech-actions-container Button {
    width: 17;
    height: 3;
    margin: 0 1;
}

#speech-flow-grid {
    layout: grid;
    grid-size: 3;
    grid-columns: 1fr 1fr 1fr;
    grid-gutter: 1;
    height: 1fr;
}

.speech-column {
    border: solid $border;
    background: $background;
    padding: 1;
    height: 1fr;
    overflow: hidden hidden;
}

#constructives-list {
    height: 1fr;
    overflow-y: auto;
}

#rebuttals-list {
    height: 1fr;
    overflow-y: auto;
}

#summary-text {
    height: 1fr;
}

.speech-column-header {
    text-style: bold;
    color: $secondary;
    border-bottom: solid $border;
    padding-bottom: 1;
    margin-bottom: 1;
}

.constructive-card-row {
    height: auto;
    align: left middle;
