/* ═══════════════════════════════════════════════════════════════
   OmniSuite Shared Theme
   Unified Cyber-Dark Glassmorphic Design System
   ═══════════════════════════════════════════════════════════════ */

/* ── Design Tokens ── */
$primary: #10b981;
$accent: #6366f1;
$danger: #ef4444;
$warning: #f59e0b;
$success: #4ade80;
$background: #020617;
$surface: #0f172a;
$surface-elevated: #1e293b;
$border: #334155;
$text-primary: #f1f5f9;
$text-secondary: #94a3b8;
$text-muted: #475569;

/* ── Global Screen Defaults ── */
Screen {
    background: $background;
    color: $text-primary;
}

/* ── High Contrast Accessibility Mode ── */
Screen.high-contrast {
    background: #000000;
    color: #ffffff;
}
Screen.high-contrast .tactical-zone {
    border: solid #ffffff;
    background: #000000;
}
Screen.high-contrast .zone-header {
    background: #00ff00;
    color: #000000;
}

/* ── Screen Reader Linear Layout Mode ── */
#main-layout.screen-reader-optimized {
    layout: vertical;
    overflow-y: scroll;
}
#main-layout.screen-reader-optimized .tactical-zone {
    width: 100%;
    height: auto;
    min-height: 20;
    border-bottom: double $primary;
}

/* ── Vertical Navigation Ribbon ── */
#side-ribbon {
    width: 10;
    height: 1fr;
    background: $background;
    border-right: solid $border;
    align: center top;
    padding: 1 0;
}
.ribbon-btn {
    min-width: 8;
    width: 8;
    height: 4;
    margin: 1 0;
    background: transparent;
    border: none;
    padding: 0;
    color: $text-muted;
    text-align: center;
    content-align: center middle;
}
.ribbon-btn:hover {
    color: $primary;
    background: $primary 10%;
}

/* ── Metric Indicators & Tiers ── */
.tier-5 { color: $warning; text-style: bold italic underline; }
.tier-4 { color: $primary; text-style: bold; }
.tier-3 { color: #3b82f6; }
.tier-2 { color: $text-secondary; }
.tier-1 { color: $text-muted; text-style: dim; }

/* ── Gauge / HUD HUD Groups ── */
.hud-group {
    border: solid $border;
    background: $surface;
    margin: 1 0;
    padding: 0 1;
    height: auto;
}
.hud-group-label {
    text-style: bold;
    color: $primary;
    background: $primary 10%;
    width: 100%;
    padding: 0 1;
}

.bar-critical { color: $danger; text-style: bold; }
.bar-caution  { color: $warning; }
.bar-optimal  { color: $primary; text-style: bold; }

.hidden { display: none; }

/* ── Custom Component: SystemLog ── */
SystemLog {
    height: 10;
    border: thick $primary;
    background: $background;
    padding: 0 1 1 1;
    margin-bottom: 1;
    color: #9ca3af;
}
.log-header {
    text-align: center;
    text-style: bold;
    background: $surface;
    color: $primary;
    width: 100%;
    border-left: thick $primary;
    border-bottom: solid $border;
    margin-bottom: 1;
}
.log-content {
    padding: 0 1;
    color: #9ca3af;
}

/* ── Custom Component: QuickNotes ── */
QuickNotes {
    height: 1fr;
    min-height: 12;
    border: thick $primary;
    padding: 0 1 1 1;
    margin-bottom: 1;
    background: $background;
    transition: border 200ms;
}
QuickNotes.notes-saving {
    border: thick $primary;
}
QuickNotes Label {
    text-align: center;
    text-style: bold;
    background: $surface;
    color: $primary;
    width: 100%;
    border-left: thick $primary;
    border-bottom: solid $border;
    margin-bottom: 1;
}
QuickNotes TextArea {
    height: 1fr;
    background: transparent;
    border: none;
    color: $text-primary;
}

/* ── Modal Overlay Patterns ── */
.modal-overlay {
    align: center middle;
    background: $background 70%;
}
.modal-dialog {
    width: 85;
    height: auto;
    max-height: 46;
    background: $surface;
    border: thick $primary;
    padding: 1 2;
}
.modal-title {
    text-align: center;
    text-style: bold;
    background: $primary;
    color: black;
    margin-bottom: 1;
    width: 100%;
}
.modal-footer {
    align: center middle;
    height: 3;
    margin-top: 1;
}
